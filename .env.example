# Database (SQLite for local dev; swap to Postgres for production)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Admin login
ADMIN_EMAIL="ogolanick@gmail.com"
ADMIN_PASSWORD="password123"

# Email (Resend). Leave RESEND_API_KEY blank during dev and emails will
# log to the server console instead of actually sending.
RESEND_API_KEY=""
EMAIL_FROM="Property Mgt <notifications@yourdomain.com>"

# Public base URL (used in magic links). For local dev:
APP_URL="http://localhost:3000"

# WhatsApp via Twilio. Leave blank during dev and WhatsApp messages will
# log to the server console instead of actually sending.
# Get these at https://console.twilio.com — the sandbox number works for testing.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
